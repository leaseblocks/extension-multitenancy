  org.axonframework.extensions.multitenancy.autoconfig.MultiTenancySpringCloudAutoConfiguration,\
  org.axonframework.extensions.multitenancy.autoconfig.MultiTenancyLocalSegmentAutoConfiguration,\
  org.axonframework.extensions.multitenancy.autoconfig.MultiTenancyAutoConfiguration,\
  org.axonframework.extensions.multitenancy.autoconfig.MultiTenancyAxonServerAutoConfiguration
